# ePolicies backend configuration. Copy to `epolicies-rag/.env` and fill in.
# NEVER put these values in frontend/.env.local or any NEXT_PUBLIC_* variable.

# --- Gemini (Google Gen AI SDK) ---------------------------------------------
# Option 1 - Gemini Developer API key (Google AI Studio):
GOOGLE_API_KEY=
# Option 2 - Vertex AI (Google Cloud). Set to true and fill in the project/region; authenticate with a
# service-account JSON file (GOOGLE_APPLICATION_CREDENTIALS) or `gcloud auth application-default login`.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
# Generation model used for planning, evidence checks, answers and verification.
# Verified available on 2026-10-16: gemini-3.5-flash. (gemini-2.5-flash is closed to new API users.)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=4
# 0 = the most repeatable answers (the same question gives the same wording as far as possible).
GEMINI_TEMPERATURE=0
# Optional reasoning controls (leave unset for the model default):
#   Gemini 3 models: GEMINI_THINKING_LEVEL=minimal|low|medium|high
#   Gemini 2.5 models: GEMINI_THINKING_BUDGET=<tokens>
#     Recommended for gemini-2.5-flash: 1024. 0 turns reasoning off (weaker answers); unset lets thinking
#     use most of the output limit, which can cut answers off ("malformed JSON").
# GEMINI_THINKING_LEVEL=low
# GEMINI_THINKING_BUDGET=1024

# --- Embeddings (fixed model; dimensions must match the database) ------------
EMBEDDING_MODEL=gemini-embedding-001
# One of 128, 256, 512, 768, 1536, 3072. Changing it requires `python -m app.cli rebuild --confirm`.
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=50
EMBEDDING_REQUESTS_PER_MINUTE=60
EMBEDDING_MAX_RETRIES=5
# Optional cap on documents processed per ingestion run (cost control).
# EMBEDDING_MAX_DOCUMENTS_PER_RUN=

# --- PostgreSQL (the only persistent database) -------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/epolicies
DB_STATEMENT_TIMEOUT_MS=30000
# auto = use pgvector if installed on the server, otherwise the built-in array fallback (no extension needed).
# Values: auto | pgvector | array
VECTOR_BACKEND=auto

# --- Paths (relative paths resolve against epolicies-rag/) -------------------
MARKDOWN_DIR=./data/markdown
EMBEDDING_JSONL_PATH=./artifacts/embedding.jsonl
MAX_MARKDOWN_FILE_BYTES=5242880

# --- Chunking (approximate tokens, ~4 characters per token) ------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_CHUNK_TOKENS=25

# --- Retrieval ---------------------------------------------------------------
TOP_K_VECTOR=20
TOP_K_KEYWORD=20
TOP_K_EXACT=10
TOP_K_FINAL=12
RRF_K=60
# Only ranks 1..N of each search count in RRF, so a passage found low down in several searches
# cannot outrank the top hit of one search (0 = count every rank).
RRF_MAX_RANK=10
# Add synonyms and acronyms (built-in, learned from the policies, and SYNONYMS_FILE) to keyword search.
SYNONYM_EXPANSION=true
# Optional JSON list of synonym groups, e.g. [["HRP", "health rules payer"]]
SYNONYMS_FILE=
TEXT_SEARCH_CONFIG=english

# --- Agentic workflow --------------------------------------------------------
MAX_RETRIEVAL_ROUNDS=3
MAX_QUERIES_PER_ROUND=3
MAX_CONTEXT_CHUNKS=16
MAX_CONTEXT_CHARS=40000
# auto = call the LLM planner only for follow-ups, complex questions, or questions with words that
# appear in no policy (usually spelling mistakes)
PLANNER_MODE=auto
LLM_CITATION_VERIFICATION=true
# Withhold any answer that has no verified citation to your Markdown files (answers come only from your documents).
STRICT_GROUNDING=true
MAX_HISTORY_TURNS=3
CHAT_TIMEOUT_SECONDS=180

# --- API ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required to use POST /ingest and /ingest/runs over HTTP (leave empty to disable; CLI always works).
ADMIN_API_TOKEN=
ENABLE_SEARCH_DEBUG=true
EXPOSE_DIAGNOSTICS=true
LOG_LEVEL=INFO
LOG_FORMAT=json
