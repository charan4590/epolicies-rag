# Copy to frontend/.env.local. Only the public API URL belongs here —
# never put GOOGLE_API_KEY or DATABASE_URL in any frontend env file.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional logos: put the image files in frontend/public/branding/ (that folder is not committed).
# NEXT_PUBLIC_APP_LOGO=/branding/app-logo.png
# NEXT_PUBLIC_COMPANY_LOGO=/branding/company-logo.png
